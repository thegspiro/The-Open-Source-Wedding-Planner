# Wedding Organizer - Environment Configuration
# Copy this file to .env and update values for your deployment
#
# Generate a secure secret key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   or: openssl rand -hex 32

# =============================================================================
# REQUIRED
# =============================================================================

# Flask secret key for session encryption (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=change-me-to-a-random-secret-key

# =============================================================================
# REVERSE PROXY
# =============================================================================

# Set to true if the app runs behind a reverse proxy (nginx, Caddy, Traefik,
# Cloudflare Tunnel, most Unraid setups). Without it every request appears to
# come from the proxy's IP address, so all clients share one rate-limit bucket
# and ten failed logins from anyone lock out every user for five minutes.
#
# Leave false when the app is exposed directly. X-Forwarded-For can be forged,
# so trusting it without a proxy in front lets an attacker fake a new IP per
# request and skip rate limiting altogether.
# TRUST_PROXY=true

# =============================================================================
# EMAIL (Optional - for task reminders and guest emails)
# =============================================================================

# SMTP server settings
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=your-email@gmail.com

# --- Gmail Setup ---
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create app password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password as SMTP_PASSWORD

# --- Outlook / Office 365 ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# --- Amazon SES ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587

# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# =============================================================================
# ADVANCED (Optional)
# =============================================================================

# Database URL (default: SQLite in instance directory)
# DATABASE_URL=sqlite:///wedding_organizer.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/wedding_planner

# Gunicorn workers (default: 2) - increase for higher traffic
# WEB_WORKERS=2

# Gunicorn threads per worker (default: 2)
# WEB_THREADS=2
